{
  "cam_crop_jump_cuts": {
    "calls": [
      {
        "argv": [
          "fake-ffmpeg",
          "-y",
          "-t",
          "30.000",
          "-i",
          "<TMP>/source.mp4",
          "-filter_complex",
          "[0:v]select='not(between(t,2.00,3.50))',setpts=N/FRAME_RATE/TB[v_base]; [0:a]aselect='not(between(t,2.00,3.50))',asetpts=N/SR/TB[a_cut]; [v_base]split=2[cam_src][game_src]; [cam_src]crop=w=iw*0.2800:h=ih*0.4000:x=iw*0.7000:y=ih*0.5500,scale=1080:960:force_original_aspect_ratio=increase,crop=1080:960,setsar=1,fps=30[cam_panel]; [game_src]scale=1080:960:force_original_aspect_ratio=increase,crop=1080:960,setsar=1,fps=30[game_panel]; [cam_panel][game_panel]vstack=inputs=2[stacked]; color=c=#FFE600:s=1080x12:d=30.00[bar_color]; [stacked][bar_color]overlay=x='-1080+(1080*t/30.00)':y=954[with_bar]; [with_bar]subtitles='<TMP>/subs.ass':fontsdir='<TMP>/assets/fonts'[outv]; [a_cut]highpass=f=85,equalizer=f=3200:width_type=o:width=1.5:g=3.5,loudnorm=I=-14:TP=-1.0:LRA=7,alimiter=limit=0.8414:attack=5:release=50:level=disabled[voice]; [voice]alimiter=limit=0.8414:level=disabled[master_a]",
          "-map",
          "[outv]",
          "-map",
          "[master_a]",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "22",
          "-threads",
          "0",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "aac",
          "-b:a",
          "192k",
          "-ar",
          "44100",
          "-t",
          "30.000",
          "-shortest",
          "-max_muxing_queue_size",
          "1024",
          "-movflags",
          "+faststart",
          "<TMP>/out/.tmp_job_golden_short.mp4"
        ],
        "timeout": 300.0
      }
    ],
    "leftover_files": [
      "short.mp4"
    ],
    "result": "<TMP>/out/short.mp4"
  },
