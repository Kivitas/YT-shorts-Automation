# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Runtime user config (rewritten by the dashboard; config/config.example.yaml stays tracked)
config/config.yaml

# Environment Variables & Secrets
.env
.env.local
*.env
!.env.example
token.json
client_secret*.json
credentials*.json

# Runtime Data & Storage
state.db
state.db-wal
state.db-shm
data/
work/
output/
scratch/
inbox/
logs/
*.log

# Models & Weights (local SD checkpoints/LoRAs under models/ are ~650 MB and must never be committed)
*.gguf
*.bin
*.safetensors
*.ckpt
*.pt
*.pth
data/models/
models/

# Playwright Profiles & Cache
edge_profile/
data/edge_profile/

# Media Assets (User-supplied audio, video, sfx)
assets/backgrounds/*
assets/music/*
assets/sfx/*
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.aac
*.flac

# Keep asset directory structure tracked
!assets/backgrounds/.gitkeep
!assets/music/.gitkeep
!assets/sfx/.gitkeep
!assets/fonts/.gitkeep

# IDE & OS Files
.idea/
.vscode/
*.swp
*.swo
.omc/
.freebuff/
Thumbs.db
Desktop.ini
.DS_Store

# Local Windows Scripts (launchers must be tracked so a fresh clone can run them)
*.bat
!start.bat
!run.bat
!install.bat


# Remotion caption overlay (npm install output and render artifacts)
remotion/node_modules/
remotion/build/
assets/longform/sprites/
