# ==============================================================================
# AutoShorts v1.0 - Environment Configuration Template
# ==============================================================================
# TIP: All variables below can also be configured directly at runtime via the
# in-app "⚙️ Settings" button in the Web Dashboard (http://localhost:8765)
# without restarting the application.
# ==============================================================================

# Application environment and logging verbosity
APP_ENV=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Cloud LLM Provider API Keys (Optional)
# Leave blank for 100% on-device local execution with llama-cpp-python.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# YouTube Data API v3 Configuration
# Required for YouTube Data API v3 upload mode and metadata queries.
# Alternatively, configure client_secret.json and token.json via the Dashboard.
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# Local LLM GGUF Model Path (Optional)
# Absolute or project-relative path to a GGUF quantized model file.
# ------------------------------------------------------------------------------
LOCAL_GGUF_PATH=

# ==============================================================================
# NOTE ON ZERO HARDCODED MODELS POLICY:
# AutoShorts never hardcodes model names. Configuration defaults specify
# "model: null", which auto-resolves dynamically at runtime:
#  - Local: Discovers the first .gguf in data/models/ or LOCAL_GGUF_PATH
#  - Gemini: Auto-resolves to recommended multimodal models (e.g., gemini-2.5-flash)
#  - OpenRouter: Auto-resolves based on provider endpoints
# ==============================================================================
